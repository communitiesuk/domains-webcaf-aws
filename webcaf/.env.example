# Development settings
DEBUG=True
SECRET_KEY=change-me-for-local-development
DATABASE_URL=postgresql://webcaf_app:webcaf_app@localhost:54321/webcaf  # pragma: allowlist secret
REDIS_URL=redis://localhost:6379/0

# Migrations use the dedicated migrator connection and assume the owner role:
# DATABASE_URL=postgresql://webcaf_migrator:webcaf_migrator@localhost:54321/webcaf  # pragma: allowlist secret
# DATABASE_ASSUME_ROLE=webcaf_owner
# Host test database creation uses the local bootstrap role:
# DATABASE_URL=postgresql://webcaf:webcaf@localhost:54321/webcaf  # pragma: allowlist secret

# Use the local GOV.UK One Login simulator by default.
SSO_MODE=one-login
GOV_UK_ONE_LOGIN_CLIENT_ID=webcaf-local
GOV_UK_ONE_LOGIN_PRIVATE_KEY_PATH=tests/fixtures/one-login-simulator-private-key.pem
GOV_UK_ONE_LOGIN_OPENID_CONFIG_URL=http://one-login.localhost:3000/.well-known/openid-configuration
GOV_UK_ONE_LOGIN_SCOPE="openid email"
GOV_UK_ONE_LOGIN_ENVIRONMENT=integration

# Use local or localhost with DEX started by `make up_dex`.
# SSO_MODE=local

# To use the GOV.UK One Login integration environment, replace the client ID,
# private key and OpenID configuration URL with the registered client values:
# GOV_UK_ONE_LOGIN_OPENID_CONFIG_URL=https://oidc.integration.account.gov.uk/.well-known/openid-configuration
