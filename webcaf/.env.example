# Development settings
DEBUG=True
SECRET_KEY=change-me-for-local-development
DATABASE_URL=postgresql://webcaf:webcaf@localhost:54321/webcaf

# Use local or localhost with the DEX provider started by Docker Compose.
SSO_MODE=local

# Set SSO_MODE=one-login and provide these values to use GOV.UK One Login.
# GOV_UK_ONE_LOGIN_CLIENT_ID=replace-with-client-id
# GOV_UK_ONE_LOGIN_PRIVATE_KEY_PATH=replace-with-path-to/private.pem
# GOV_UK_ONE_LOGIN_OPENID_CONFIG_URL=https://oidc.integration.account.gov.uk/.well-known/openid-configuration
# GOV_UK_ONE_LOGIN_SCOPE="openid email"
# GOV_UK_ONE_LOGIN_ENVIRONMENT=integration
